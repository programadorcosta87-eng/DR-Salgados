rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Cardápio: qualquer pessoa pode visualizar, mas só usuários autenticados alteram
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Configurações da loja (WhatsApp, Pix, marca): público para leitura, protegido para escrita
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Pedidos: qualquer cliente pode criar um pedido; apenas usuários autenticados gerenciam/alteram
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
    
    // Dados de Clientes e Fidelidade: criação/leitura de pedidos ou restrito a autenticados
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }
    
    // Estoque e Receitas: dados internos, apenas usuários autenticados
    match /ingredients/{ingredientId} {
      allow read, write: if isAuthenticated();
    }
    
    // Funcionários: dados sensíveis, apenas usuários autenticados
    match /employees/{employeeId} {
      allow read, write: if isAuthenticated();
    }
  }
}
